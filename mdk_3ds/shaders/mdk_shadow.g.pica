; ============================================================================
; mdk_shadow.g.pica -- the SHADOW RECEIVE program's geometry shader: the sun's
; shadow on a Lit surface, on the PICA200 (Enhanced Mode enableSkyShadows,
; SPEC.md 7.9).
;
; The PC (mdk_linux/shaders/enhanced.frag) lights a Lit surface with
;
;     light = hemisphere + sun * facing * sunlight(position, normal)
;
; where sunlight() is 1 in the sun and 0 in its shadow. The lit program
; (mdk_c3d.g.pica) has already drawn the surface as if sunlight() were 1:
; texture * F_lit, F_lit = to_srgb(exposure * (hemisphere + sun * facing)). In
; the shadow the same surface is texture * F_shadow, F_shadow = to_srgb(exposure
; * hemisphere). Both are constant over the triangle (the lights are
; directional), so the shadowed colour is the lit one times
;
;     R = F_shadow / F_lit        (per channel, <= 1, per TRIANGLE)
;
; and THAT is what this pass does: the surface is drawn a second time, depth
; EQUAL, multiplying the picture by mix(1, R, shadow) -- 06_draw.inc's
; receiveShadows has the combiner and the blend. The clamp of the lit program
; (F >= 2 is white) is applied to both terms here, so the ratio is the ratio of
; what was drawn.
;
; WHERE THE SHADOW COMES FROM. Texture unit 0 is the shadow map (a PICA shadow
; texture: the sun's depth, rendered by the caster pass). Its coordinate is the
; vertex's place in the sun's map -- (u, v) and, in texcoord0w, its depth from
; the sun -- from the world position the vertex shader hands over, pushed along
; the face normal by the PC's ShadowNormalOffset and pulled towards the sun by
; its depth bias. The unit compares that depth with the map's (2x2, blended) and
; answers 1 in the light, 0 in the shadow.
;
; THE FOURTH COLOUR CHANNEL is how much of the shadow reaches the screen:
;     q = haze kept * (1 - edge)
; `haze kept` (the vertex shader's colour.w) because the haze was mixed in AFTER
; the light and must not be darkened with it; `edge` fades the shadow out over
; the last tenth of the map, as the PC does, and is 1 outside the map, so a
; surface the map does not cover is never shadowed whatever the unit reads
; there.
;
; INPUTS (the vertex shader's outputs, three vertices of four registers):
;   v0-v3   first vertex:  clip position, colour (w: haze kept), texcoord,
;                          world position
;   v4-v7   second vertex
;   v8-v11  third vertex
; ============================================================================

.gsh point c0

; Uniforms (written at every bind by the backend: installShadowUniforms).
.fvec sunDir        ; xyz: the direction the sun SHINES
.fvec sunColour     ; rgb
.fvec skyColour     ; rgb
.fvec groundColour  ; rgb
.fvec camera        ; xyz: the eye's world position
.fvec params        ; x exposure, y normal offset (world units), z depth bias (0-1 of the reach)
.fvec sunMtx[4]     ; world -> (u, v, depth, 1) of the shadow map, a row a register

.constf consts(0.0, 1.0, 0.5, 0.45454545)   ; 0, 1, 1/2, 1/GAMMA (2.2)
.constf consts2(2.0, -1.0, 1.0e-12, 10.0)   ; 2, -1, the degenerate floor, 1 / fade width
.constf consts3(0.9, 0.5, 1.5, 0.0)         ; x: where the edge fade starts (1 - fade width);
                                            ; y, z: the harness probe's two thresholds
.alias zeros consts.xxxx
.alias ones  consts.yyyy
.alias half  consts.zzzz
.alias invGamma consts.wwww
.alias two   consts2.xxxx
.alias minus1 consts2.yyyy
.alias tiny  consts2.zzzz
.alias invFade consts2.wwww
.alias fadeStart consts3.xxxx

.out outpos position
.out outclr color
.out outtc  texcoord0
.out outtcw texcoord0w

.entry smain
.proc smain
    ; THE FACE NORMAL, turned to the camera: mdk_c3d.g.pica's, line for line
    ; (every scalar in all four lanes, for the reason given there).
    mov r0, v7
    add r0, -v3, r0
    mov r1, v11
    add r1, -v3, r1
    mul r2, r0.yzxw, r1.zxyw
    mul r3, r0.zxyw, r1.yzxw
    add r2, r2, -r3
    mov r2.w, zeros
    dp3 r3, r2, r2
    max r3, tiny, r3
    rsq r3, r3
    mul r2, r2, r3
    add r4, camera, -v3
    dp3 r5, r2, r4
    slt r5, zeros, r5
    mul r5, two, r5
    add r5, minus1, r5
    mul r2, r2, r5                 ; r2 = n

    ; THE TWO LIGHTS: H = exposure * hemisphere, L = H + exposure * sun * facing.
    mov r6, r2.zzzz
    mul r6, half, r6
    add r6, half, r6
    mov r7, groundColour
    add r7, skyColour, -r7
    mul r7, r7, r6
    add r7, groundColour, r7       ; hemisphere
    dp3 r8, -sunDir, r2
    max r8, zeros, r8              ; facing
    mul r9, sunColour, r8
    add r9, r7, r9                 ; hemisphere + sun * facing
    mul r7, params.xxxx, r7        ; H
    mul r9, params.xxxx, r9        ; L

    ; F / 2 of each, clamped at 1, exactly as the lit program draws it.
    max r7, zeros, r7
    lg2 r10.x, r7.x
    lg2 r10.y, r7.y
    lg2 r10.z, r7.z
    mul r10, invGamma, r10
    ex2 r11.x, r10.x
    ex2 r11.y, r10.y
    ex2 r11.z, r10.z
    mul r11, half, r11
    min r11, ones, r11             ; F_shadow / 2

    max r9, zeros, r9
    lg2 r10.x, r9.x
    lg2 r10.y, r9.y
    lg2 r10.z, r9.z
    mul r10, invGamma, r10
    ex2 r12.x, r10.x
    ex2 r12.y, r10.y
    ex2 r12.z, r10.z
    mul r12, half, r12
    min r12, ones, r12             ; F_lit / 2
    max r12, tiny, r12

    ; R = F_shadow / F_lit, never above 1.
    rcp r13.x, r12.x
    rcp r13.y, r12.y
    rcp r13.z, r12.z
    mul r13, r11, r13
    min r13, ones, r13
    mov r13.w, ones

    ; The normal offset, in world units.
    mul r14, params.yyyy, r2
    mov r14.w, zeros

    ; EMIT the triangle: each vertex with its place in the sun's map.
    mov r0, v3
    mov r4, v1
    call shadowvertex
    setemit 0
    mov outpos, v0
    mov outtc, r1
    mov outtcw, r1.z
    mov outclr, r15
    emit

    mov r0, v7
    mov r4, v5
    call shadowvertex
    setemit 1
    mov outpos, v4
    mov outtc, r1
    mov outtcw, r1.z
    mov outclr, r15
    emit

    mov r0, v11
    mov r4, v9
    call shadowvertex
    setemit 2, prim
    mov outpos, v8
    mov outtc, r1
    mov outtcw, r1.z
    mov outclr, r15
    emit

    end
.end

; One vertex. IN: r0 = world position (w 1), r4 = its colour (w: haze kept),
; r13 = R, r14 = the normal offset. OUT: r1 = (u, v, depth), r15 = (R, q).
; Uses r3, r5.
.proc shadowvertex
    add r0, r14, r0
    mov r0.w, ones
    dp4 r1.x, sunMtx[0], r0
    dp4 r1.y, sunMtx[1], r0
    dp4 r1.z, sunMtx[2], r0
    add r1.z, -params.zzzz, r1.z   ; the depth bias: towards the sun
    max r1.z, zeros, r1.z
    ; (The harness's probe 2, params.w = 2: every receiver at ONE depth,
    ; params.z itself -- sweeping it reads the map's depths back.)
    mov r5, params
    slt r3, consts3.zzzz, r5.wwww  ; 1 when params.w > 1.5
    add r5.z, r5.z, -r1.z
    mul r5.z, r3.z, r5.z
    add r1.z, r1.z, r5.z
    mov r1.w, ones

    ; edge = max(|2u - 1|, |2v - 1|); fade = clamp((edge - 0.9) * 10, 0, 1).
    mul r3, two, r1
    add r3, minus1, r3
    mov r5, r3
    max r3, -r5, r3                ; |.|
    max r3.x, r3.y, r3.x
    add r3.x, -fadeStart, r3.x
    mul r3.x, invFade, r3.x
    max r3.x, zeros, r3.x
    min r3.x, ones, r3.x
    add r3.x, ones, -r3.x          ; 1 - fade
    mul r3.x, r4.w, r3.x           ; * haze kept

    ; (params.w is the harness's probe: 1 shows this vertex's place in the
    ; map -- u, v, depth -- as its colour, 0 is the shadow's factor R.)
    add r5, -r13, r1
    mul r5, params.wwww, r5
    add r15, r13, r5               ; mix(R, (u, v, depth), params.w)
    mov r15.w, r3.x
.end
