; ============================================================================
; mdk_c3d.v.pica — the MDK vertex shader for the 3DS.
;
; ONE uniform matrix, at registers 0-3, holding the combined model-view-
; projection. The CPU composes it (see renderer_c3d.cpp's buildEyeMvp) and the
; PICA200 does the transform on the GPU: neither backend ever transforms
; vertices on the CPU. See the Obsidian note
; "port-mvp-transform-locus-cpu-vs-gpu".
;
; THE 90-DEGREE ROTATION IS IN THE MATRIX, NOT HERE. The 3DS framebuffer is
; 240x400 portrait and the game is landscape, so the projection carries the
; rotation. It is a PROPER ROTATION (determinant +1): the upstream picaGL
; version used a reflection (determinant -1) which flips the winding a
; second time and undoes the cull inversion. See ../forsaken/3DS_PORT_NOTES.md.
;
; THE UV TRANSFORM, at register 4.
;
; THE PICA200'S TEXTURE DIMENSIONS ARE POWERS OF TWO. The texture size
; register encodes log2(width) and log2(height), so 128x176 IS NOT A TEXTURE
; THE HARDWARE CAN HOLD -- a 128x128 one is, and a 128x176 one is not, and
; the allocation fails with no diagnostic at all. MDK's textures are
; 256x400, 128x176, 256x320 and so on: every one of them has to be PADDED UP
; to the next power of two.
;
; A padded texture is larger than the image it holds, so the texture
; coordinate has to be scaled and offset to address the right part of it:
;
;     uv' = uv * scale + offset
;
; `scale` is the real size over the padded size, and `offset` is the frame's
; origin for an animated texture (the frames are stacked vertically, and the
; original's shader picks the frame with `uv.y = (frac(uv.y) + frame) /
; frame_count`).
;
; THE TINT, at uniform register 5.
;
; WHY A UNIFORM AND NOT A VERTEX COLOUR. The 2D canvas tints its quads: the
; skull fades in by drawing the sprite multiplied by an alpha, and a flat
; rectangle is a colour with no texture at all. The Vulkan backend carries that
; tint as a per-draw push constant (renderer_vk.cpp's PushConstants::colour), so
; the seam already treats the tint as PER DRAW, not per vertex -- and the
; original's shader does the same thing (`color * tint` over a material tint,
; shaders/palette.hlsl). A vertex colour attribute would be the other design:
; it would widen every vertex in the game by four bytes to carry a value that
; is constant across a whole draw, and the world's surfaces are unlit and
; untinted, so 100% of the arena's vertices would carry a constant.
;
; It is a vec4 and not a packed word on purpose: the four channels arrive as
; four floats, so there is no byte order to get wrong. The two colour byte
; orders this backend already had to measure (the clear word and the texel,
; pica_matrix.h) are both pinned; a fifth, unverifiable one was avoided
; instead of added.
;
; Attributes (bound by C3D_AttrInfo):
;   v0 = position (float3)
;   v1 = texcoord (float2)
;
; TWO attributes, five floats a vertex. The packed RGBA8 colour is NOT
; uploaded: the original look's world surfaces are unlit (the palette
; decides the colour) and the flat-coloured surfaces are drawn with a
; one-pixel texture of that colour, so the colour never reaches the
; fragment stage. The output colour is the tint uniform, which every
; untinted draw leaves at white.
; ============================================================================

.constf constants(0.0, 1.0, -1.0, 0.5)
.alias  zeros constants.xxxx
.alias  ones  constants.yyyy

.out outpos position
.out outclr color
.out outtexcoord texcoord0

; Inputs
.alias inpos v0
.alias intex v1

; The combined model-view-projection, in uniform registers 0-3.
.fvec mvp[4]

; The UV transform, in uniform register 4: x and y are the scale, z and w
; are the offset. A single vec4, not an array.
.fvec uvtransform

; The tint, in uniform register 5. White for every draw that does not ask for
; a colour; the 2D canvas writes it per draw.
.fvec tint

; The haze (Enhanced Mode enableHaze, SPEC.md 7.9), in uniform register 6:
; x = -density * log2(e) for a draw that takes the haze, 0 for every other.
; The vertex keeps ex2(x * clip.w) of its colour (clip.w is the eye depth), and
; that fraction rides in the primary colour's alpha to combiner stage 1, which
; blends toward the haze colour by it. With x = 0, ex2(0) = 1: the alpha is the
; tint's own, exactly as before. Why here and not the PICA fog unit:
; pica_matrix.h, THE HAZE.
.fvec haze

.entry vmain
.proc vmain
    ; THE w COMPONENT IS FORCED TO 1.0, AND IT IS MEASURED TO MAKE NO
    ; DIFFERENCE. Both statements belong in this comment, because the second one
    ; is the only reason anyone would ever write the first.
    ;
    ; `inpos` is a THREE-component attribute (GPU_FLOAT, 3). Every devkitARM
    ; citro3d vertex shader example forces the fourth component anyway -- they
    ; carry the literal line `; Force the w component of inpos to be 1.0`
    ; (examples/3ds/graphics/gpu/simple_tri/source/vshader.v.pica:21-23), and so
    ; does the vault (60-references/3ds-platform/citro3d/
    ; 04-drawing-attributes-vbo.md:197-199) -- so `mov r0, inpos` read as a
    ; defect: if w came through as 0, every row of the MVP would be dotted with
    ; (x, y, z, 0), the fourth column -- the TRANSLATION -- would be multiplied by
    ; zero, and the GPU would project the world as if the camera sat at the world
    ; origin. That would also have explained, for free, why the diagnostic triangle
    ; drawn through an IDENTITY matrix paints nothing at all (clip.w = 0 is
    ; degenerate) while every CPU-side probe read correct.
    ;
    ; IT IS NOT THE CAUSE, AND THAT IS MEASURED. The build with this line in it
    ; produces a panel crop BYTE-IDENTICAL to the build without it (pixel sha
    ; 75b22ac5... , docs/evidence/2026-11-09-L7-shader-w-{parent,current}.txt), so
    ; the PICA's attribute loader already fills w with 1.0 for a 3-component float
    ; attribute and the shader was never receiving a zero. The one-sided view is
    ; still open, and this is one fewer candidate cause for it -- recorded here so
    ; the next batch does not spend an iteration re-deriving it.
    ;
    ; KEPT ANYWAY, for the reason the contract gives for every other piece of GPU
    ; state: the old form worked only because of an unpacker behaviour the shader
    ; never named. Say what the shader needs instead of depending on it.
    ;
    ; The matrix-vector product. dp4 writes only the x component of its
    ; destination, so each row of the matrix is dotted with the position
    ; separately.
    mov r0.xyz, inpos
    mov r0.w,   ones
    dp4 outpos.x, mvp[0], r0
    dp4 outpos.y, mvp[1], r0
    dp4 outpos.z, mvp[2], r0
    dp4 outpos.w, mvp[3], r0

    ; THE TINT IS THE PRIMARY COLOUR. An untinted draw has white here, and the
    ; combiner's REPLACE(texture) ignores this register entirely; the canvas's
    ; draws use MODULATE(texture, primary), which is the oracle's `color * tint`
    ; (shaders/palette.hlsl) including its alpha, which is what fades the skull.
    dp4 r2.x, mvp[3], r0
    mul r2.x, haze.x, r2.x
    ex2 r2.x, r2.x
    mov r3, tint
    mul r3.w, r3.w, r2.x
    mov outclr, r3

    ; The texture coordinate, scaled and offset for the padded texture.
    mov r1, uvtransform
    mov r0, intex
    mul r0.x, r0.x, r1.x
    mul r0.y, r0.y, r1.y
    add r0.x, r0.x, r1.z
    add r0.y, r0.y, r1.w
    mov outtexcoord, r0

    end
.end
