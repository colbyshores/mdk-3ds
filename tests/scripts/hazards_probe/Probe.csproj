<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsRidAgnostic>false</IsRidAgnostic>
    <!-- EffectsView.cs and MaterialResolver.cs below, and Program.cs's CPU-only Renderer, shadow
         the referenced assemblies' types of the same names inside this probe (the `sprites` token). -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Mdk.Formats\Mdk.Formats.csproj" />
    <ProjectReference Include="..\src\Mdk.Engine\Mdk.Engine.csproj" />
    <ProjectReference Include="..\src\Mdk.Game\Mdk.Game.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The C#'s own effects draw stage, compiled unmodified against the probe's Renderer. -->
    <Compile Include="..\src\Mdk.Game\Objects\EffectsView.cs" Link="Upstream\EffectsView.cs" />
    <Compile Include="..\src\Mdk.Game\Level\MaterialResolver.cs" Link="Upstream\MaterialResolver.cs" />
  </ItemGroup>
</Project>
