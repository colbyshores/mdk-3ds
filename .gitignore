# Build output
build/
build-*/
*.o
*.d
*.elf
*.map
*.3dsx
*.cia
*.smdh
*.shbin
*.spv
*.pyc
__pycache__/

# The user's own copy of the commercial game. It is staged into the RomFS at
# build time and is NOT committed: it is a copyrighted game, and the build
# stages it from MDK_DATA_DIR or <repo>/MDK. No trailing slash: /MDK/ matches
# only a directory, and a symlink to the game folder must be ignored too.
/MDK

# The 3DS build's staged RomFS. Rebuilt by mdk_3ds/tools/stage_romfs.sh.
/mdk_3ds/romfs/*
!/mdk_3ds/romfs/.gitkeep

# The test artefacts
/tests/**/*.out
/tests/**/*.png
/tests/**/*.json.out

# C# build output. The C# is no longer in the tree (it is upstream 1.1.1,
# d5bb66ec); this keeps an older checkout's left-over src/*/bin and obj quiet.
bin/
obj/

# Local logs and per-checkout markers.
logs/

# Loop and measurement output stays out of the tree; the history of it is on
# branch harness/3ds-profiling.
.progress-log/
docs/frames/
# docs/evidence holds only the files the completion ledger cites.
